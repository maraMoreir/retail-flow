        <mxCell id="e17" edge="1" parent="1" source="n5" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 8;strokeColor=#0066CC;strokeWidth=3;fontSize=10;" target="n9" value="envia cupom">
