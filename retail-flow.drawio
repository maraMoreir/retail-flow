        <mxCell id="n10" parent="n2" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Protheus Adapter&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[REST / SOAP]&lt;/i&gt;" vertex="1">
