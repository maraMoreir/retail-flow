          <mxGeometry height="80" width="255" x="1340" y="140" as="geometry" />
        </mxCell>
        <mxCell id="deve8" edge="1" parent="1" source="devn3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="devn4" value="token">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deve9" edge="1" parent="1" source="devn4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="devn5" value="chave pública">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deve10" edge="1" parent="1" source="devn5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="devn6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deve11" edge="1" parent="1" source="devn6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="devn7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devn12" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="Revogar é &lt;b&gt;uma linha no banco&lt;/b&gt;: status = revoked, e o dispositivo para de sincronizar na próxima tentativa - sem depender de alcançá-lo. A loja recebe outro equipamento sem afetar nada. Revogação não apaga histórico: as vendas já sincronizadas continuam atribuídas a ele." vertex="1">
          <mxGeometry height="50" width="1535" x="60" y="235" as="geometry" />
        </mxCell>
        <mxCell id="devn13" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fillColor=#666666;fontColor=#FFFFFF;textShadow=0;fontSize=16;" value="2. CONTRATO - versão do contrato ≠ versão do Edge (ADR-0023)" vertex="1">
          <mxGeometry height="34" width="1574" x="40" y="300" as="geometry" />
        </mxCell>
        <mxCell id="devn14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Edge v5.3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;X-Contract-Version: 2&lt;br&gt;X-Client-Version: 5.3.0&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="60" y="350" as="geometry" />
        </mxCell>
        <mxCell id="devn15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;v1 adapter · v2 adapter&lt;br&gt;domínio conhece UM modelo&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="320" x="500" y="350" as="geometry" />
        </mxCell>
        <mxCell id="devn16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#F5D9E8;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;426 Upgrade Required&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Contrato fora da janela.&lt;br&gt;Devolve minContractVersion&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="980" y="350" as="geometry" />
        </mxCell>
        <mxCell id="devn17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFCC;strokeColor=none;strokeWidth=3;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;GET /device/recovery&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[SEM VERSÃO - congelado]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Único caminho de volta.&lt;br&gt;Sem ele, loja atrasada vira tijolo&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="275" x="1320" y="350" as="geometry" />
        </mxCell>
        <mxCell id="deve18" edge="1" parent="1" source="devn14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="devn15" value="compatível">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deve19" edge="1" parent="1" source="devn15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="devn16" value="incompatível">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deve20" edge="1" parent="1" source="devn16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="devn17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deve21" edge="1" parent="1" source="devn17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 8;strokeColor=#0066CC;strokeWidth=3;fontSize=10;" target="devn14" value="ponteiro de atualização">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devn22" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;O deadlock que o canal de recuperação evita:&lt;/b&gt; loja 6 meses offline volta falando contrato v1, já descontinuado. É rejeitada na sincronização - que é justamente por onde receberia a atualização. Sem um endpoint que nunca quebra, só resolve com visita presencial." vertex="1">
          <mxGeometry height="50" width="1535" x="60" y="445" as="geometry" />
        </mxCell>
        <mxCell id="devn23" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fillColor=#666666;fontColor=#FFFFFF;textShadow=0;fontSize=16;" value="3. ATUALIZAÇÃO - a cloud decide o alvo, o Edge nunca escolhe (ADR-0025)" vertex="1">
          <mxGeometry height="34" width="1574" x="40" y="510" as="geometry" />
        </mxCell>
        <mxCell id="devn24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Anel 0&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[interno]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;mín. 1 dia&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="220" x="60" y="560" as="geometry" />
        </mxCell>
        <mxCell id="devn25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Anel 1&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[piloto acordado]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;mín. 3 dias&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="220" x="300" y="560" as="geometry" />
        </mxCell>
        <mxCell id="devn26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Anel 2&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[~10% da frota]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;mín. 3 dias&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="220" x="540" y="560" as="geometry" />
        </mxCell>
        <mxCell id="devn27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Anel 3&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[restante]&lt;/i&gt;" vertex="1">
          <mxGeometry height="65" width="220" x="780" y="560" as="geometry" />
        </mxCell>
        <mxCell id="deve28" edge="1" parent="1" source="devn24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="devn25" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deve29" edge="1" parent="1" source="devn25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="devn26" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deve30" edge="1" parent="1" source="devn26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="devn27" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devn31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;assinatura + checksum&lt;/b&gt;" vertex="1">
          <mxGeometry height="65" width="260" x="1040" y="560" as="geometry" />
        </mxCell>
        <mxCell id="devn32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;staging + health check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;exercita emissão de teste&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="265" x="1330" y="560" as="geometry" />
        </mxCell>
        <mxCell id="deve33" edge="1" parent="1" source="devn31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="devn32" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devn34" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;Rollback não desfaz migração de schema.&lt;/b&gt; Migrações do Edge são forward-only e o Edge tira snapshot do SQLite antes de migrar; o rollback restaura binário E snapshot juntos. Mas o snapshot é anterior à migração então se já houve venda desde ele, o rollback é &lt;b&gt;proibido&lt;/b&gt; e o dispositivo fica em failed, escalando para humano. Perder venda é pior que ficar parado." vertex="1">
          <mxGeometry height="65" width="1535" x="60" y="645" as="geometry" />
        </mxCell>
        <mxCell id="devn35" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;A janela de suporte do contrato sai desta página:&lt;/b&gt; permanência somada dos anéis + período máximo plausível de loja offline + margem. Mudar a cadência de rollout obriga a revisar o ADR-0023. São a mesma decisão, não duas.&lt;br&gt;&lt;br&gt;E o mais importante: &lt;b&gt;atualização nunca é pré-requisito para vender&lt;/b&gt;. Loja offline fica pending e aplica quando conseguir." vertex="1">
          <mxGeometry height="90" width="1535" x="60" y="725" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Personal Data Flow" id="94my_TDJ6ylIqnQqV9Vu">
    <mxGraphModel dx="1303" dy="783" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#E6E6E6" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pdn1" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fillColor=#d80073;fontColor=#ffffff;textShadow=0;fontSize=16;strokeColor=#A50040;" value="Fluxo de dado pessoal, bases legais e retenção - LGPD × obrigação fiscal (ADR-0027)" vertex="1">
          <mxGeometry height="44" width="1574" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="pdn2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#F5D9E8;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;ERP do cliente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Cadastro completo de clientes&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="80" y="120" as="geometry" />
        </mxCell>
        <mxCell id="pdn3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Réplica de cliente&lt;br&gt;nome · documento&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="500" y="120" as="geometry" />
        </mxCell>
        <mxCell id="pdn4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFCC;strokeColor=none;strokeWidth=3;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Store Edge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Réplica mínima, &lt;b&gt;sob demanda&lt;/b&gt;&lt;br&gt;não é dump do cadastro&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="920" y="120" as="geometry" />
        </mxCell>
        <mxCell id="pdn5" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;shadow=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[cifrado em repouso]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Expurgo agressivo:&lt;br&gt;some quando a venda fecha&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="275" x="1320" y="120" as="geometry" />
        </mxCell>
        <mxCell id="pde6" edge="1" parent="1" source="pdn2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 8;strokeColor=#0066CC;strokeWidth=3;fontSize=10;" target="pdn3" value="sync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pde7" edge="1" parent="1" source="pdn3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 8;strokeColor=#0066CC;strokeWidth=3;fontSize=10;" target="pdn4" value="só o necessário para vender">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pde8" edge="1" parent="1" source="pdn4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="pdn5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pdn9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#F5D9E8;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Documento fiscal&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[CPF na nota]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;XML no object storage&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="500" y="280" as="geometry" />
        </mxCell>
        <mxCell id="pde10" edge="1" parent="1" source="pdn4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="pdn9" value="venda identificada">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pdn11" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fillColor=#666666;fontColor=#FFFFFF;textShadow=0;fontSize=16;" value="OS DOIS REGIMES - dados que se parecem e têm regras opostas" vertex="1">
          <mxGeometry height="34" width="1574" x="40" y="410" as="geometry" />
        </mxCell>
        <mxCell id="pdn12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFCC;strokeColor=none;strokeWidth=3;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;XML fiscal com CPF&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[base legal: OBRIGAÇÃO LEGAL]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;5 anos. Não se apaga, não se anonimiza.&lt;/b&gt;&lt;br&gt;Pedido de eliminação NÃO alcança este dado -&lt;br&gt;obrigação legal é base autônoma para retenção&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="720" x="80" y="460" as="geometry" />
        </mxCell>
        <mxCell id="pdn13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Réplica operacional de cliente&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[base legal: execução de contrato]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Retenção curta. Expurgada quando não mais necessária.&lt;/b&gt;&lt;br&gt;Pedido de eliminação alcança este dado.&lt;br&gt;Nunca tratar pelo mesmo caminho de expurgo do fiscal&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="755" x="840" y="460" as="geometry" />
        </mxCell>
        <mxCell id="pdn14" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fillColor=#666666;fontColor=#FFFFFF;textShadow=0;fontSize=16;" value="RETENÇÃO NO SQLITE - por categoria, nunca por idade única" vertex="1">
          <mxGeometry height="34" width="1574" x="40" y="605" as="geometry" />
        </mxCell>
        <mxCell id="pdn15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Operacional&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;sessão em aberto, cache&lt;br&gt;→ por idade&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="280" x="80" y="655" as="geometry" />
        </mxCell>
        <mxCell id="pdn16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFCC;strokeColor=none;strokeWidth=3;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Sincronização (outbox)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;até CONFIRMAÇÃO da cloud&lt;br&gt;→ nunca por idade&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="300" x="400" y="655" as="geometry" />
        </mxCell>
        <mxCell id="pdn17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Fiscal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;até transmitido e arquivado&lt;br&gt;→ depois, obrigação&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="280" x="740" y="655" as="geometry" />
        </mxCell>
        <mxCell id="pdn18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Auditoria&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;política própria, mais longa&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="250" x="1060" y="655" as="geometry" />
        </mxCell>
        <mxCell id="pdn19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Réplica de cliente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;some quando a venda fecha&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="245" x="1350" y="655" as="geometry" />
        </mxCell>
        <mxCell id="pdn20" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;A regra que mais importa:&lt;/b&gt; uma mensagem de outbox nunca é apagada por ser velha. Ela sai por estado de negócio -&amp;nbsp; pending → published → confirmed → purged. Outbox velha não é lixo: é venda que não chegou. Apagá-la por idade é perder faturamento em silêncio, que é o pior modo de falha possível. Outbox parada além de um limiar gera &lt;b&gt;alerta&lt;/b&gt;, não expurgo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Proibido em qualquer caso:&lt;/b&gt; CPF em log, em rótulo de métrica, em URL ou em query string. Em telemetria, no máximo hash com sal - sem sal, o espaço de CPFs é pequeno o bastante para reversão por força bruta." vertex="1">
          <mxGeometry height="110" width="1515" x="80" y="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
