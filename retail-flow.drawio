        <mxCell id="n14" parent="n2" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Telemetry Buffer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Emite quando online&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="260" x="700" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="n2" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;O componente que decide se a loja para.&lt;/b&gt; O Contingency Controller observa a resposta da SEFAZ: cStat 108/109, erro de rede ou estouro do timeout curto trocam a emissão para contingência offline. O cupom sai assinado localmente, entra na outbox e é transmitido quando o serviço volta, dentro do prazo da UF." vertex="1">
          <mxGeometry height="70" width="920" x="40" y="620" as="geometry" />
        </mxCell>
        <mxCell id="n16" parent="n2" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;Réplica, não cadastro.&lt;/b&gt; Catálogo, preço e estoque chegam do ERP pela cloud. O Edge nunca é fonte da verdade desses dados - mas precisa deles localmente para vender offline, então mantém uma réplica com vigência." vertex="1">
          <mxGeometry height="60" width="920" x="40" y="700" as="geometry" />
        </mxCell>
        <mxCell id="n17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;POS App&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[.NET 10 / PWA]&lt;/i&gt;" vertex="1">
