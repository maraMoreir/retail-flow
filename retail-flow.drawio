        </mxCell>
        <mxCell id="n11" parent="n2" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Sankhya Adapter&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[arquivo em SFTP]&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="660" y="350" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="n2" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Resilience&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[circuit breaker]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Por cliente, nunca global&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="40" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="n2" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFCC;strokeColor=#FF0000;strokeWidth=3;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Reconciliation Report&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Divergência PDV × ERP, diária&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="350" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="n2" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Divergence Queue&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Registro rejeitado pelo ERP,&lt;br&gt;com dono e SLA&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="660" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="n2" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;Por que anticorrupção e não integração direta.&lt;/b&gt; Cada ERP tem seu modelo, seu transporte e seu vocabulário. Sem uma camada que traduza para um modelo canônico, o primeiro cliente define o domínio do produto e o segundo exige reescrita. O adaptador absorve transporte e formato; o núcleo só conhece o canônico." vertex="1">
          <mxGeometry height="70" width="900" x="40" y="600" as="geometry" />
        </mxCell>
        <mxCell id="n16" parent="n2" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;A reconciliação é obrigatória, não um relatório bonito.&lt;/b&gt; O ERP vai recusar registros - produto inexistente, filial errada, período fechado. Sem um confronto diário do que o PDV vendeu contra o que o ERP aceitou, a divergência só aparece no fechamento contábil do mês." vertex="1">
          <mxGeometry height="70" width="900" x="40" y="680" as="geometry" />
        </mxCell>
        <mxCell id="n17" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;shadow=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Eventos de venda&lt;/span&gt;" vertex="1">
