        <mxCell id="capn10" parent="capn2" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fillColor=#666666;fontColor=#FFFFFF;textShadow=0;fontSize=16;" value="PORTAS SEGREGADAS - o adaptador implementa só o que o ERP faz" vertex="1">
