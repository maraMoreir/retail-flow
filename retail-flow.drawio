        </mxCell>
        <mxCell id="mode27" edge="1" parent="1" source="modn10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontSize=10;" target="modn14" value="">
