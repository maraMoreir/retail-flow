        <mxCell id="n1" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fillColor=#d80073;fontColor=#ffffff;textShadow=0;fontSize=16;strokeColor=#A50040;" value="&lt;strong&gt;RETAIL FLOW&lt;/strong&gt;&lt;br&gt;&lt;br&gt;&lt;em&gt;PDV offline conectado ao ERP&lt;/em&gt;&amp;nbsp;&lt;div&gt;&amp;nbsp;Arquitetura TO BE&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="1534" x="60" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;PDV multi-loja, multi-ERP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Ponto de venda com operação offline, emissão fiscal própria e integração com o ERP do cliente.&lt;br&gt;O ERP é dono do catálogo, do preço e do estoque. O PDV consome, vende e devolve o resultado.&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="1534" x="60" y="140" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fillColor=#99CCFF;fontColor=#FFFFFF;textShadow=0;fontSize=16;" value="Índice" vertex="1">
