        <mxCell id="n3" parent="n2" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;POS App&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[.NET 10 / PWA]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Tela de caixa e periféricos&lt;/span&gt;" vertex="1">
