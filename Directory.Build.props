<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <!-- CS1591: no XML-doc-for-every-public-member requirement (not shipping these as NuGet packages).
         CA1716: identifiers like "Shared"/"Error" only collide with VB.NET/F# keywords - pure-C# solution.
         CA1305: culture-specific overloads (this is a server backend with no localized formatting).
         CA1848: LoggerMessage source-gen delegates - not worth the ceremony for every single log call. -->
    <NoWarn>$(NoWarn);CS1591;CA1716;CA1305;CA1848</NoWarn>

    <Authors>RetailFlow Contributors</Authors>
    <Company>RetailFlow</Company>
    <Product>RetailFlow</Product>
    <RepositoryUrl>https://github.com/maraMoreir/retail-flow</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!--
    Treat warnings as errors only in Release builds (e.g. CI), so local `dotnet build`
    during active development stays fast to iterate on without blocking on style nits.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
